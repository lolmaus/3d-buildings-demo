{
  "version": 8,
  "name": "Self-Hosted Bright 3D (Fixed)",
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://REPLACE_ME_IN_CODE"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F8F4F0"
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["==", "kind", "residential"],
      "paint": { "fill-color": "#e0e4dd" }
    },
    {
      "id": "landuse_commercial",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["==", "kind", "commercial"],
      "paint": { "fill-color": "#f2eae2" }
    },
    {
      "id": "landuse_industrial",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["==", "kind", "industrial"],
      "paint": { "fill-color": "#ecebe8" }
    },
    {
      "id": "landuse_green",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["in", "kind", "park", "grass", "forest", "wood", "cemetery"],
      "paint": { "fill-color": "#d8e8c8", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill-extrusion",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "all",
        ["!=", "tunnel", "yes"],
        ["!=", "tunnel", 1],
        ["!=", "is_tunnel", "yes"]
      ],
      "paint": {
        "fill-extrusion-color": "#AECFE2",
        "fill-extrusion-height": 0,
        "fill-extrusion-base": 0,
        "fill-extrusion-translate": [0, 0]
      }
    },

    {
      "id": "roads_casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#cfcdca",
        "line-width": {
          "stops": [
            [12, 3],
            [16, 9]
          ]
        }
      }
    },
    {
      "id": "roads_inner",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "stops": [
            [12, 1],
            [16, 7]
          ]
        }
      }
    },
    {
      "id": "highways_inner",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "in",
        "kind",
        "highway",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fea",
        "line-width": {
          "stops": [
            [12, 1.5],
            [16, 8]
          ]
        }
      }
    },
    {
      "id": "buildings-3d",
      "type": "fill-extrusion",
      "source": "protomaps",
      "source-layer": "buildings",
      "filter": [">", "height", 0],
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["get", "height"],
          0,
          "#f2eae2",
          50,
          "#dfdbd7",
          100,
          "#99a"
        ],
        "fill-extrusion-height": ["get", "height"],
        "fill-extrusion-base": ["get", "min_height"],
        "fill-extrusion-opacity": 0.9
      }
    },
    {
      "id": "place_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["noto-sans"],
        "text-size": 14
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "road_labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": ["all", ["has", "name"], ["!=", "kind", "ferry"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["noto-sans"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    }
  ]
}
